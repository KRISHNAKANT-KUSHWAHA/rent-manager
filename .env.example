# Server Configuration
PORT=5100
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/rent_manager

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Frontend Client URL (for CORS and cookie matching)
CLIENT_URL=http://localhost:5173

# ImageKit Cloud Storage (For Aadhaar photos, documents & receipts)
# Get free keys at: https://imagekit.io (Free 20GB/month)
IMAGEKIT_PUBLIC_KEY=public_your_public_key_here
IMAGEKIT_PRIVATE_KEY=private_your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id/

